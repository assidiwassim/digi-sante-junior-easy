# Variables d'environnement par défaut du projet.
#
# Ordre de chargement (le dernier gagne) :
#   .env  ->  .env.local  ->  .env.$APP_ENV  ->  .env.$APP_ENV.local
#
# Ne mettez jamais de secret de production dans ce fichier : il est versionné.
# Pour vos réglages personnels, créez un fichier .env.local (non versionné).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8081
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Connexion MySQL utilisée quand PHP tourne SUR VOTRE MACHINE (hors Docker),
# avec la base MySQL du fichier compose.yaml (port 3308).
#
# Dans le conteneur `app`, cette valeur est remplacée par la variable
# DATABASE_URL définie dans compose.yaml (hôte `database`, port 3306).
#
# Avec votre propre MySQL, copiez cette ligne dans .env.local et adaptez
# utilisateur, mot de passe, hôte, port et nom de base.
DATABASE_URL="mysql://digisante:digisante@127.0.0.1:3308/digisante_junior?serverVersion=8.0.36&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
