# Modèle des secrets de déploiement — À COPIER, JAMAIS À REMPLIR ICI.
#
# Sur le serveur :
#   cp .env.prod.dist .env.prod
#   nano .env.prod          (remplacer les trois valeurs)
#   chmod 600 .env.prod
#
# Ce fichier-ci est versionné : il ne doit contenir aucune vraie valeur.
# `.env.prod` est ignoré par Git.
#
# Pour générer une valeur aléatoire :
#   openssl rand -hex 16

# Clé de signature de Symfony (sessions, jetons CSRF, « se souvenir de moi »).
# La changer déconnecte tout le monde : c'est normal.
APP_SECRET=a_remplacer_par_32_caracteres_aleatoires

# Mot de passe de l'utilisateur applicatif MySQL.
# Uniquement des lettres et des chiffres : il est inséré dans DATABASE_URL,
# où les caractères spéciaux devraient être encodés.
MYSQL_PASSWORD=a_remplacer_par_un_mot_de_passe_long

# Mot de passe root de MySQL, utilisé pour l'administration et les sauvegardes.
MYSQL_ROOT_PASSWORD=a_remplacer_par_un_autre_mot_de_passe_long
