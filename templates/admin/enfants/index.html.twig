{% extends 'admin/layout.html.twig' %}

{% block title %}Enfants — Administration{% endblock %}

{% block body %}
    <div>
        <h1 class="mb-0">Enfants</h1>
        <p class="mb-0 texte-doux">{{ enfants|length }} profil(s) enfant.</p>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Enfant</th>
                        <th>Âge</th>
                        <th>Identifiant</th>
                        <th>Parent</th>
                        <th>Limite</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for enfant in enfants %}
                        <tr>
                            <td class="text-nowrap"><span class="fs-5">{{ enfant.avatarEmoji }}</span> <strong>{{ enfant.nomComplet }}</strong></td>
                            <td>{{ enfant.age }} ans</td>
                            <td>{{ enfant.compte.username }}</td>
                            <td><a href="{{ path('admin_parent_voir', {id: enfant.parent.id}) }}">{{ enfant.parent.email }}</a></td>
                            <td>{{ enfant.maxMinutesJour|duree }}</td>
                            <td class="text-end text-nowrap">
                                <a href="{{ path('admin_enfant_voir', {id: enfant.id}) }}" class="btn btn-fantome btn-sm">👁️ Voir</a>
                                {% include '_partials/bouton_supprimer.html.twig' with {
                                    action: path('admin_enfant_supprimer', {id: enfant.id}),
                                    jeton: 'supprimer-enfant-' ~ enfant.id,
                                    confirmation: 'Supprimer définitivement le profil de ' ~ enfant.nomComplet ~ ', son compte et tous ses journaux ?',
                                } only %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center texte-doux py-5">Aucun profil enfant.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
