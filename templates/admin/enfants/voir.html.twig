{% extends 'admin/layout.html.twig' %}

{% block title %}{{ enfant.nomComplet }} — Administration{% endblock %}

{% block body %}
    <a href="{{ path('admin_enfants') }}" class="fw-bold">← Retour aux enfants</a>

    <div class="row g-4 align-items-start">
        {# --- Profil --------------------------------------------------------- #}
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-bulle">{{ enfant.avatarEmoji }}</div>
                        <div>
                            <div class="stat-libelle">Profil enfant</div>
                            <h1 class="fs-4 mb-0">{{ enfant.nomComplet }}</h1>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <div class="profil-ligne">
                            <span class="profil-cle">Âge</span>
                            <span class="profil-valeur">{{ enfant.age }} ans · né(e) le {{ enfant.dateNaissance|date('d/m/Y') }}</span>
                        </div>
                        <div class="profil-ligne">
                            <span class="profil-cle">Identifiant</span>
                            <span class="profil-valeur">{{ enfant.compte.username }}</span>
                        </div>
                        <div class="profil-ligne">
                            <span class="profil-cle">Parent</span>
                            <span class="profil-valeur">
                                <a href="{{ path('admin_parent_voir', {id: enfant.parent.id}) }}">{{ enfant.parent.email }}</a>
                            </span>
                        </div>
                        <div class="profil-ligne">
                            <span class="profil-cle">Limite d'écran</span>
                            <span class="profil-valeur">{{ enfant.maxMinutesJour|duree }} par jour</span>
                        </div>
                        <div class="profil-ligne">
                            <span class="profil-cle">Journées remplies</span>
                            <span class="profil-valeur">{{ enfant.journalEntrees|length }}</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        {% include '_partials/bouton_supprimer.html.twig' with {
                            action: path('admin_enfant_supprimer', {id: enfant.id}),
                            jeton: 'supprimer-enfant-' ~ enfant.id,
                            confirmation: 'Supprimer définitivement le profil de ' ~ enfant.nomComplet ~ ', son compte et tous ses journaux ?',
                        } only %}
                    </div>
                </div>
            </div>
        </div>

        {# --- Derniers journaux ---------------------------------------------- #}
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <div class="carte-titre">📔 Derniers journaux</div>

                    {% if journaux is empty %}
                        <p class="texte-doux mb-0">{{ enfant.prenom }} n'a encore rempli aucun journal.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Écran</th>
                                        <th>Douleurs</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for journal in journaux %}
                                        <tr>
                                            <td>{{ journal.date|date('d/m/Y') }}</td>
                                            <td class="fw-bold {{ journal.totalEcran > enfant.maxMinutesJour ? 'texte-rouge' : 'texte-vert' }}">
                                                {{ journal.totalEcran|duree }}
                                            </td>
                                            <td>
                                                {% for douleur in journal.douleurs %}
                                                    <span class="pastille">{{ douleur.zoneEmoji }} {{ douleur.zoneLabel }} · {{ douleur.intensite }}/5</span>
                                                {% else %}
                                                    <span class="texte-doux">—</span>
                                                {% endfor %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
